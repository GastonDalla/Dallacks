# cosine.club API key — get yours at https://cosine.club/account/api
# Read ONLY on the server (BFF proxy). Never exposed to the browser.
COSINE_API_KEY=your_api_key_here

# Optional: override upstream base URL (defaults to https://cosine.club/api/v1)
# COSINE_API_BASE_URL=https://cosine.club/api/v1

# Public site URL for canonical/OG/sitemap. Defaults to the production domain
# (https://tracks.gastondalla.com). Override for previews or local dev.
# NEXT_PUBLIC_SITE_URL=https://tracks.gastondalla.com

# Optional: Discord webhook to log what users search/use (server-side only).
# Leave empty to disable. Create one in your Discord server settings.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
